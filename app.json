{
  "expo": {
    "name": "Amparo",
    "slug": "Amparo",
    "version": "1.0.1",
    "icon": "./assets/amparoIcon.png",
    "orientation": "portrait",
    "backgroundColor": "#5C9EDC",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amparo.app",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "O Amparo utiliza notificações para lembrar o usuário dos horários de seus medicamentos."
      }
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logoAForeground.png",
        "backgroundColor": "#5C9EDC"
      },
      "package": "com.amparo.app"
    },

    "web": {
      "favicon": "./assets/amparoIcon.png"
    },

    "notification": {
    "icon": "./assets/logoAForeground.png",
    "color": "#5C9EDC"
    },

    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5C9EDC",
          "image": "./assets/amparoIcon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/alarm.mp3"
          ],
          "defaultChannel": "default"
        }
      ]
    ],

    "extra": {
      "eas": {
        "projectId": "703db930-8fce-4cbf-8ac4-bef0ca546ade"
      }
    }
  }
}