{
  "expo": {
    "name": "Amparo",
    "slug": "amparo",
    "version": "1.0.0",
    "icon": "./assets/amparoIcon.png",
    "orientation": "portrait",
    "backgroundColor": "#5C9EDC",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lari.amparo"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5C9EDC"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.amparo.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "703db930-8fce-4cbf-8ac4-bef0ca546ade"
      }
    }
  }
}
